{
  "name": "@kurone-kito/japanese-law-translation-root",
  "version": "0.1.4",
  "private": true,
  "description": "The unofficial library package provides bilingual English translations of legal terms in Japan.",
  "keywords": ["english", "japanese", "legal", "law", "translation", "words"],
  "homepage": "https://github.com/kurone-kito/japanese-law-translation#readme",
  "bugs": "https://github.com/kurone-kito/japanese-law-translation/issues",
  "repository": "github:kurone-kito/japanese-law-translation",
  "license": "CC-BY-4.0",
  "author": "kurone-kito <krone@kit.black> (https://kit.black/)",
  "type": "module",
  "files": [],
  "scripts": {
    "build": "pnpm run --workspace-concurrency=Infinity -r build",
    "builder": "pnpm --filter @kurone-kito/japanese-law-translation exec jlt-builder",
    "clean": "pnpm run --no-bail -p \"/^clean:.+/\"",
    "clean:root": "rimraf -g \"*.tgz\" \"*.tsbuildinfo\" \"node_modules/.cache/**/*\"",
    "clean:sub": "pnpm run --parallel --workspace-concurrency=Infinity -r clean",
    "crawler": "pnpm --filter @kurone-kito/japanese-law-translation exec jlt-crawler",
    "lint": "pnpm run \"/lint:.+:check/\"",
    "lint:biome:check": "biome check",
    "lint:biome:fix": "biome check --write",
    "lint:cspell:check": "cspell lint --no-progress --show-suggestions -u \"./**/*\"",
    "lint:fix": "pnpm run lint:cspell:check && pnpm run \"/lint:.+:fix/\"",
    "lint:markdown:check": "markdownlint-cli2 \"**/*.md\"",
    "lint:markdown:fix": "markdownlint-cli2 --fix \"**/*.md\"",
    "pnpm:devPreinstall": "pnpm run \"/pnpm:devPreinstall:.+/\"",
    "pnpm:devPreinstall:mkdir": "pnpm dlx mkdirp packages/jlt-builder/dist packages/jlt-crawler/dist",
    "pnpm:devPreinstall:touch": "pnpm dlx touch packages/jlt-builder/dist/index.mjs packages/jlt-crawler/dist/index.mjs",
    "prepare": "husky",
    "publish": "pnpm run build && pnpm -r publish",
    "publish:next": "pnpm run publish --tag next",
    "start": "pnpm run build && pnpm run --parallel --workspace-concurrency=Infinity -r start",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@cspell/cspell-types": "^9.0.2",
    "@kurone-kito/biome-config": "0.19.0",
    "@kurone-kito/commitlint-config": "^0.19.0",
    "@kurone-kito/cspell-config": "^0.19.0",
    "@kurone-kito/lint-staged-config": "^0.19.0",
    "@kurone-kito/markdownlint-config": "^0.19.0",
    "@kurone-kito/typescript-config": "^0.19.0",
    "cspell": "^9.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "markdownlint-cli2": "^0.18.1",
    "rimraf": "^6.0.1",
    "typescript": "~5.8.3",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@10.12.1+sha512.f0dda8580f0ee9481c5c79a1d927b9164f2c478e90992ad268bbb2465a736984391d6333d2c327913578b2804af33474ca554ba29c04a8b13060a717675ae3ac",
  "engines": {
    "node": "^20.11 || ^22 || >=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
